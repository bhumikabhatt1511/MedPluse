# MedPulse Backend Configuration Template
# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medpulse?schema=public"

# Google Gemini API Key (Optional: for Live GenAI Explainable Reasoning)
# If left empty, MedPulse automatically runs its Deterministic Clinical Safety Reasoning Engine.
GEMINI_API_KEY=""
